<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardController"
            prefWidth="1100" prefHeight="700">

    <!-- THANH MENU BÊN TRÁI -->
    <left>
        <VBox spacing="15" style="-fx-background-color: #2c3e50;"
              prefWidth="220" alignment="TOP_CENTER" padding="20">
            
            <ImageView fitWidth="100" fitHeight="100" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/app_icon.png" />
                </image>
            </ImageView>
            
            <Text text="HỆ THỐNG CHẤM CÔNG"
                  style="-fx-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />

            <Separator style="-fx-background-color: #bdc3c7;" />

            <Button fx:id="btnHome" text=" Trang chủ"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />

            <Button fx:id="btnEmployee" text="  Nhân viên"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />

            <Button fx:id="btnProject" text=" Dự án"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />

            <Button fx:id="btnAttendance" text=" Chấm công"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />

            <Button fx:id="btnReports" text=" Báo cáo / KPI"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnLogout" text=" Đăng xuất"
                    onAction="#handleMenuAction"
                    prefWidth="180"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />

        </VBox>
    </left>

    <!--  THANH TIÊU ĐỀ (HEADER)  -->
    <top>
        <HBox style="-fx-background-color: #34495e;" padding="10" spacing="15">
            <Label text="📋 BẢNG ĐIỀU KHIỂN HỆ THỐNG"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!--  KHU VỰC HIỂN THỊ NỘI DUNG CHÍNH -->
    <center>
        <AnchorPane style="-fx-background-color: #ecf0f1;">
            <!-- Trang con (home.fxml, employee.fxml, project.fxml...) sẽ được nạp vào đây bằng Controller -->
        </AnchorPane>
    </center>
</BorderPane>
